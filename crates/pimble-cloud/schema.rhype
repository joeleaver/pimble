// Pimble Cloud accounts service schema (docs/CLOUD_CONTRACT.md, section C:
// "Identity and grants").
//
// Deviations from the contract's literal field list, both deliberate:
//
// 1. `User.user_uuid` is the JWT `sub` — a UUID minted by this service at
//    signup (never RhypeDB's own internal `id`, which is an implementation
//    detail of the database and not something we hand out or accept back
//    from a client). Likewise `HostedStore.store_id` is the Pimble server's
//    own `StoreId` (also a UUID), not RhypeDB's internal id.
//
// 2. `Session.user_rid`, `Grant.user_rid`/`Grant.store_rid`/`Grant.store_uuid`
//    are redundant scalar copies of what the `user`/`store` relations already
//    say. RhypeDB's query language has no relation-equality filter — reading
//    rhypedb-query's parser and executor (`Predicate::Compare`'s right-hand
//    side is always a scalar `Literal`; `evaluate_predicate` reads the
//    comparison field straight out of the object's own FieldMap, which never
//    contains a relation) confirms `.filter(.store == HostedStore.get(1))` is
//    not a thing today, and neither is `@unique` across a pair of relations.
//    Without these scalar copies, "does a grant already exist for (user,
//    store)", "list a store's members", and "build this user's JWT `stores`
//    claim" would each need a relation traversal per candidate row instead of
//    one scalar-filtered query. The `user`/`store` relations stay for
//    referential correctness (and are what a future phase's `@on_delete`
//    policies would hang off); the scalars are a query-performance shortcut,
//    not the source of truth.

type User {
    user_uuid: String @unique
    email: String
    email_lower: String @unique
    // Argon2id(auth_key) since phase 2a (docs/CRYPTO_CONTRACT.md): the field
    // and the hashing are unchanged from phase 1b's password_hash, only what
    // gets hashed changed (the server never sees a password any more).
    password_hash: String
    created_at: DateTime
    // Phase 1b (email verification): unverified at signup. `verify_token_hash`
    // is sha256(opaque verify token), empty string once verified or replaced
    // by a newer token (an empty query token is rejected before it would ever
    // match this sentinel — see routes/accounts.rs::verify). `verify_expires_at`
    // is 24h from when the token was (re)issued.
    verified: Bool
    verify_token_hash: String
    verify_expires_at: DateTime
    // Phase 2a (docs/CRYPTO_CONTRACT.md "Data model additions"): every field
    // below is required from signup on — there is no keyless `User` row any
    // more (the two pre-phase-2a smoke accounts are deleted on migration; see
    // this crate's README). `kdf_*` and `public_*` are plain scalars;
    // `account_key_blob` and `recovery_key_blob` are `pimble_crypto::
    // AccountKeyBlob` serialized to a JSON string (opaque to this schema,
    // exactly like `KeyGrant.envelope` below).
    kdf_salt: String
    kdf_m_cost: u32
    kdf_t_cost: u32
    kdf_p_cost: u32
    public_encryption_key: String
    public_signing_key: String
    account_key_blob: String
    recovery_salt: String
    recovery_key_blob: String
    // Phase 2a-2 (docs/CRYPTO_CONTRACT.md "account recovery, password
    // change, new recovery code"): `POST /recover/start`'s emailed token,
    // sha256'd, one hour, one use — same sentinel-on-absent-or-consumed
    // pattern as `verify_token_hash` above. Absent on every row from before
    // this addition (read as optional; see db.rs's `get_string_opt`/
    // `get_datetime_ms_opt` callers in `user_from_object`), which is
    // correct: no in-flight recovery to speak of for a row that predates
    // the field.
    recovery_token_hash: String
    recovery_token_expires_at: DateTime
    // docs/PRESENCE_CONTRACT.md section 3: the name this person goes by
    // wherever a share has no name of their own for them (`ShareName`), and
    // on their own devices. Empty or absent until they choose one (absent on
    // every row from before the field; read optional), when the local part
    // of their email stands in.
    display_name: String
    // docs/NOTIFICATIONS_CONTRACT.md section 2: the account's notice key, an
    // X25519 key pair used for notices and nothing else. The public half
    // (base64url) is published with the other public keys; the envelope is
    // the secret sealed to the account itself (a `pimble_crypto::KeyEnvelope`
    // as JSON, opaque here, like `KeyGrant.envelope`). Both empty or absent
    // until the account's first signed-in device of wave 1 makes one.
    notice_public_key: String
    notice_key_envelope: String
    // Section 6: notifications are on from sign-in; `true` once the person
    // turns them off (absent on every row from before: on).
    notifications_off: Bool
    // Section 6, per channel (wave 2): `true` once the person turns email,
    // or web push, off. Absent on every row from before: on.
    notify_email_off: Bool
    notify_push_off: Bool
    // Section 3, wave 3: `true` once the person turns watched notes off
    // (which deletes their watches). Absent on every row from before: on.
    notify_watches_off: Bool
    // Section 4: when the last notice email went to this person (at most one
    // an hour). Absent or epoch zero: never.
    notice_emailed_at: DateTime
}

type Session {
    token_hash: String @unique
    user: User
    user_rid: u64 @indexed
    expires_at: DateTime
    created_at: DateTime
}

type HostedStore {
    store_id: String @unique
    name: String
    dir_name: String
    created_at: DateTime
    deleted: Bool
    // Phase 2a (docs/CRYPTO_CONTRACT.md): `"plain"` or `"vault"`, matching
    // `pimble_core::StoreKind`'s serde spelling. Kept as a plain String like
    // every other field here rather than an enum, since this schema has no
    // enum type and the Pimble server is the source of truth for what the
    // string means. Absent on every row created before Phase 2a — read
    // optional (`hosted_store_from_object`, defaulting to `"plain"`), like
    // every field added after a generation shipped.
    kind: String
    // Dead since docs/NODE_DOCUMENT_CONTRACT.md section 5: a share was
    // briefly a vault store of its own (`share: true`), and is now a scoped
    // grant on the owner's own store — `Grant.root` below. Nothing writes
    // this field any more and nothing reads it (`hosted_store_from_object`
    // ignores it), but production rows from that cut still carry it, so the
    // declaration stays: a field a stored row has and the schema does not is
    // not a shape this database has ever been asked to load.
    share: Bool
    // docs/RELAY_CONTRACT.md: `"hosted"` (the store's encrypted twin lives on
    // the hosted Pimble server) or `"relay"` (nothing of the store is on
    // Pimble Cloud at all: the owner's own machine serves it and this service
    // only pipes members' connections to it). A relay-tier row is a record
    // that grants, invitations and key envelopes can hang off, and nothing
    // more: its `name` is whatever the owner's device sent (the empty string)
    // and its `dir_name` is empty, because there is no directory. Absent on
    // every row written before the relay tier existed — read optional as
    // `"hosted"`, which is what every such store is.
    tier: String
}

// An address invited to a store that has no verified account yet. One row per
// (store, email_lower, root), enforced in the service (find-then-create/update)
// like `Grant`'s (user, store, root) — see this file's header comment on why
// relation-pair uniqueness isn't a schema-level thing here. An invitation
// becomes a `Grant` and is deleted the moment the address is claimed (at
// verification and at every login), so nothing here is ever read for an
// account that exists.
//
// `store_rid`/`store_uuid` are the same denormalized scalar copies `Grant`
// carries, for the same reason. `email_lower` is what the claim path queries.
// `invited_by_rid` is a scalar with no matching relation on purpose: the
// inviter is only ever read back to name them in the invitation mail, and a
// row whose inviter has since deleted their account is still a perfectly good
// invitation (the lookup simply finds nothing and the mail says the store's
// name instead).
type Invitation {
    store: HostedStore
    store_rid: u64 @indexed
    store_uuid: String
    email: String
    email_lower: String @indexed
    role: String
    // The scope this invitation is for, exactly like `Grant.root` below: the
    // empty string for the whole store, a node id for a share. Carried into
    // the grant when the address is claimed. Absent on every row written
    // before shares became scopes — read optional, defaulting to the whole
    // store, which is what those rows really are.
    root: String
    // What the owner called this share, exactly like `Grant.share_name`
    // below, and carried into the grant with `root` when the address is
    // claimed. Empty for a whole-store invitation (the store has a name of
    // its own). Read optional, like every field added after rows existed.
    share_name: String
    invited_by_rid: u64
    created_at: DateTime
}

type Grant {
    user: User
    store: HostedStore
    role: String
    // docs/NODE_DOCUMENT_CONTRACT.md section 5: a grant has a scope. The
    // empty string is the whole store (every grant before shares became
    // scopes); a node id is a share — this user holds `role` on that node and
    // the documents under it, and on nothing else in the store. One row per
    // (user, store, root), enforced in the service. Absent on every row
    // written before this field existed, read optional as the whole store.
    root: String
    // What the owner called this share (Joe, 2026-09-21: "a share has a name
    // of its own"): the name a recipient's store list shows, so the owner's
    // store name never reaches them. Empty for a whole-store grant, which is
    // named by its store. Every grant and invitation of one (store, root)
    // carries the same name — `PUT members` rewrites them all — so a share
    // has one name however many people hold it. Absent on every row written
    // before this field existed; read optional, like every later field.
    share_name: String
    user_rid: u64 @indexed
    store_rid: u64 @indexed
    store_uuid: String
}

// The name one person goes by in one share (docs/PRESENCE_CONTRACT.md
// section 3, Joe 2026-10-22): what every other member of that share is shown
// for them instead of their email. One row per (user, store, root), enforced
// in the service like `Grant`'s; `root` is a node id for a share, the empty
// string for a whole-store grant. Its own type rather than a `Grant` field
// because an owner holds the store through one whole-store grant and still
// has a name per share. No row (or an empty name) means `User.display_name`.
type ShareName {
    user: User
    store: HostedStore
    user_rid: u64 @indexed
    store_rid: u64 @indexed
    store_uuid: String
    root: String
    name: String
}

// Phase 2a (docs/CRYPTO_CONTRACT.md "Data model additions"): one row per
// (user, store, key_id, scope_root) — a store's key rotates by adding a new
// key_id and new envelopes per member, never by mutating an old row (old blobs
// still need their old envelope to decrypt). That uniqueness is enforced in
// the service, like `Grant`'s `(user, store, root)` — see schema.rhype's
// header comment on why relation-pair uniqueness isn't a schema-level thing
// here.
type KeyGrant {
    user: User
    store: HostedStore
    key_id: String
    // Which scope key this envelope carries (docs/NODE_DOCUMENT_CONTRACT.md
    // section 5): the empty string for the store key, a node id for that
    // share's key. Absent on every row from before shares became scopes —
    // read optional as the store key, which every such envelope holds.
    scope_root: String
    // A `pimble_crypto::KeyEnvelope` serialized to a JSON string — opaque to
    // this schema and to RhypeDB, exactly like `User.account_key_blob`.
    envelope: String
    user_rid: u64 @indexed
    store_rid: u64 @indexed
    store_uuid: String
}

// The personal document of an account (docs/DISCUSSIONS_CONTRACT.md section
// 8): what its person has read in discussions and where they were in each
// node, as one blob sealed with a key only their own devices derive. This
// service stores the ciphertext and a version a write must name, nothing
// else. Written once the person signs in (signing in is the asking), deleted
// when they turn it off.
type PersonalDoc {
    user_uuid: String @unique
    blob: String
    version: u64
    updated_at: DateTime
}

// A sealed notice waiting in its recipient's inbox
// (docs/NOTIFICATIONS_CONTRACT.md section 2). The service knows who sent it
// to whom, about which share (store and root, `""` for a whole store), and
// when; `sealed` is opaque to it. Undelivered items older than a day are
// dropped rather than delivered late; delivered ones go when acknowledged,
// or seven days after their first delivery. `item_uuid` is what devices name
// it by; the row's own id orders a recipient's items (the drain's cursor).
//
// Wave 2 (section 4): `delivered` is "seen by a device": a running device
// drained it, or a browser's service worker showed its push. An item that is
// neither seen nor acknowledged (deleted) fifteen minutes after it was queued
// is emailed, once (`emailed`). `kind` is what the sender says it is
// (`"mention"`, `"reply"`, `""` when it said nothing), in the clear, so the
// email can say "mentioned you" without reading the notice. Both absent on
// rows from before wave 2: not emailed, no kind.
type InboxItem {
    item_uuid: String @unique
    recipient_uuid: String @indexed
    sender_uuid: String
    store_uuid: String
    root: String
    sealed: String
    created_at: DateTime
    delivered: Bool
    delivered_at: DateTime
    kind: String
    emailed: Bool
    // Wave 3: for a `"watch"` item (queued by this service itself, sealed
    // to the recipient), how many changes it stands for, what an email or a
    // push says. Absent on every other row: none.
    count: u64
}

// One browser's Web Push subscription (docs/NOTIFICATIONS_CONTRACT.md
// section 4, wave 2): where its push service takes pushes for it
// (`endpoint`) and the keys a push is encrypted to (RFC 8291: `p256dh`, the
// browser's P-256 public key, and `auth`, its 16-byte secret, both
// base64url). One row per endpoint, enforced in the service; a push service
// answering 404 or 410 deletes it.
type PushSubscription {
    user_uuid: String @indexed
    endpoint: String @indexed
    p256dh: String
    auth: String
    created_at: DateTime
}

// Watches (docs/NOTIFICATIONS_CONTRACT.md section 3, wave 3).
//
// What a person chose to watch is their own account data: one blob sealed
// with a key only their devices derive (as `PersonalDoc`), and a version a
// write must name. Opaque here. The row outlives the switch turned off
// (`sealed` emptied, the version moved on), so a version never goes back
// and a device holding older choices can never write them again.
type WatchChoices {
    user_uuid: String @unique
    sealed: String
    version: u64
    updated_at: DateTime
}

// One document a person watches, registered by their devices from those
// choices: opaque ids (a node's document id is its node id), so this
// service matches writes against them without knowing what they are. A
// device replaces a store's set whole as nodes come and go.
type WatchedDoc {
    user_uuid: String @indexed
    store_uuid: String @indexed
    doc_uuid: String @indexed
    created_at: DateTime
}

// Writes gathered for one watcher, per (document, writer): one notice is
// queued once the writer has been quiet for five minutes (or an hour after
// the first). `batch_key` is "watcher/store/doc/writer". `count` is spells
// of editing (writes half a minute or more apart), not appends; `spells`
// is their spans, JSON `[[first_ms, last_ms], ...]`, so a write told late
// is judged by the writes it falls between (`pimble_core::watch::Spells`);
// `first_at` and `last_at` are the first and last of them. `root` is
// the share the watcher was told through ("" for the whole store), checked
// again when the notice is queued. `reports` is the relay reports gathered
// into it, JSON `{ "<report id>": taken_ms }`, so a report sent again
// gathers none of its writes twice; a batch a pass took while it names any
// stays with no spells until they are forgotten (30 days). Kept here, not
// in memory, so a deploy loses none.
type WatchBatch {
    batch_key: String @unique
    watcher_uuid: String @indexed
    store_uuid: String
    doc_uuid: String
    writer_uuid: String
    root: String
    count: u64
    spells: String
    first_at: DateTime
    last_at: DateTime
    reports: String
}

// A relay report already taken (`POST /api/v1/watches/writes`'s `report`,
// a UUID the owner's device gives each batch it keeps and sends until it is
// taken). Remembered for 30 days, so a report sent again because its answer
// was lost (the app quit, the connection broke) is not gathered twice.
type RelayReport {
    report_uuid: String @unique
    store_uuid: String
    taken_at: DateTime
}
