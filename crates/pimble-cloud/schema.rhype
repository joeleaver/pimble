// Pimble Cloud accounts service schema (docs/CLOUD_CONTRACT.md, section C:
// "Identity and grants").
//
// Deviations from the contract's literal field list, both deliberate:
//
// 1. `User.user_uuid` is the JWT `sub` — a UUID minted by this service at
//    signup (never RhypeDB's own internal `id`, which is an implementation
//    detail of the database and not something we hand out or accept back
//    from a client). Likewise `HostedStore.store_id` is the Pimble server's
//    own `StoreId` (also a UUID), not RhypeDB's internal id.
//
// 2. `Session.user_rid`, `Grant.user_rid`/`Grant.store_rid`/`Grant.store_uuid`
//    are redundant scalar copies of what the `user`/`store` relations already
//    say. RhypeDB's query language has no relation-equality filter — reading
//    rhypedb-query's parser and executor (`Predicate::Compare`'s right-hand
//    side is always a scalar `Literal`; `evaluate_predicate` reads the
//    comparison field straight out of the object's own FieldMap, which never
//    contains a relation) confirms `.filter(.store == HostedStore.get(1))` is
//    not a thing today, and neither is `@unique` across a pair of relations.
//    Without these scalar copies, "does a grant already exist for (user,
//    store)", "list a store's members", and "build this user's JWT `stores`
//    claim" would each need a relation traversal per candidate row instead of
//    one scalar-filtered query. The `user`/`store` relations stay for
//    referential correctness (and are what a future phase's `@on_delete`
//    policies would hang off); the scalars are a query-performance shortcut,
//    not the source of truth.

type User {
    user_uuid: String @unique
    email: String
    email_lower: String @unique
    // Argon2id(auth_key) since phase 2a (docs/CRYPTO_CONTRACT.md): the field
    // and the hashing are unchanged from phase 1b's password_hash, only what
    // gets hashed changed (the server never sees a password any more).
    password_hash: String
    created_at: DateTime
    // Phase 1b (email verification): unverified at signup. `verify_token_hash`
    // is sha256(opaque verify token), empty string once verified or replaced
    // by a newer token (an empty query token is rejected before it would ever
    // match this sentinel — see routes/accounts.rs::verify). `verify_expires_at`
    // is 24h from when the token was (re)issued.
    verified: Bool
    verify_token_hash: String
    verify_expires_at: DateTime
    // Phase 2a (docs/CRYPTO_CONTRACT.md "Data model additions"): every field
    // below is required from signup on — there is no keyless `User` row any
    // more (the two pre-phase-2a smoke accounts are deleted on migration; see
    // this crate's README). `kdf_*` and `public_*` are plain scalars;
    // `account_key_blob` and `recovery_key_blob` are `pimble_crypto::
    // AccountKeyBlob` serialized to a JSON string (opaque to this schema,
    // exactly like `KeyGrant.envelope` below).
    kdf_salt: String
    kdf_m_cost: u32
    kdf_t_cost: u32
    kdf_p_cost: u32
    public_encryption_key: String
    public_signing_key: String
    account_key_blob: String
    recovery_salt: String
    recovery_key_blob: String
    // Phase 2a-2 (docs/CRYPTO_CONTRACT.md "account recovery, password
    // change, new recovery code"): `POST /recover/start`'s emailed token,
    // sha256'd, one hour, one use — same sentinel-on-absent-or-consumed
    // pattern as `verify_token_hash` above. Absent on every row from before
    // this addition (read as optional; see db.rs's `get_string_opt`/
    // `get_datetime_ms_opt` callers in `user_from_object`), which is
    // correct: no in-flight recovery to speak of for a row that predates
    // the field.
    recovery_token_hash: String
    recovery_token_expires_at: DateTime
}

type Session {
    token_hash: String @unique
    user: User
    user_rid: u64 @indexed
    expires_at: DateTime
    created_at: DateTime
}

type HostedStore {
    store_id: String @unique
    name: String
    dir_name: String
    created_at: DateTime
    deleted: Bool
    // Phase 2a (docs/CRYPTO_CONTRACT.md): `"plain"` or `"vault"`, matching
    // `pimble_core::StoreKind`'s serde spelling. Missing on no row created by
    // this crate (every `create_hosted_store` call sets it), kept as a plain
    // required String like every other field here rather than an enum, since
    // this schema has no enum type and the Pimble server is the source of
    // truth for what the string means.
    kind: String
}

type Grant {
    user: User
    store: HostedStore
    role: String
    user_rid: u64 @indexed
    store_rid: u64 @indexed
    store_uuid: String
}

// Phase 2a (docs/CRYPTO_CONTRACT.md "Data model additions"): one row per
// (user, store, key_id) — a store's key rotates by adding a new key_id and
// new envelopes per member, never by mutating an old row (old blobs still
// need their old envelope to decrypt). `(user, store, key_id)` uniqueness is
// enforced in the service, like `Grant`'s `(user, store)` — see schema.rhype's
// header comment on why relation-pair uniqueness isn't a schema-level thing
// here.
type KeyGrant {
    user: User
    store: HostedStore
    key_id: String
    // A `pimble_crypto::KeyEnvelope` serialized to a JSON string — opaque to
    // this schema and to RhypeDB, exactly like `User.account_key_blob`.
    envelope: String
    user_rid: u64 @indexed
    store_rid: u64 @indexed
    store_uuid: String
}
