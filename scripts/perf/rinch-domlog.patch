+/// PROFILING ONLY (scratch copy): describe a node and its ancestors.
+pub(crate) fn prof_describe(tree: &crate::node::NodeTree, id: usize) -> String {
+    let mut out = Vec::new();
+    let mut cur = Some(id);
+    let mut n = 0;
+    while let Some(i) = cur {
+        let Some(node) = tree.nodes.get(i) else { break };
+        let d = match &node.kind {
+            crate::node::NodeKind::Element(e) => {
+                let c = node.attributes.get("class").map(|c| c.split_whitespace().take(2).collect::<Vec<_>>().join(".")).unwrap_or_default();
+                if c.is_empty() { e.tag.clone() } else { format!("{}.{}", e.tag, c) }
+            }
+            _ => "#text".into(),
+        };
+        out.push(d);
+        n += 1;
+        if n >= 9 { break; }
+        cur = node.parent.map(|p| p as usize);
+    }
+    out.join(" < ")
+}
+
+pub(crate) fn prof_on() -> bool {
+    thread_local!(static ON: bool = std::env::var("RINCH_DOMLOG").is_ok());
+    ON.with(|v| *v)
+}
+
+pub(crate) fn prof_log(tree: &crate::node::NodeTree, what: &str, id: usize) {
+    if prof_on() {
+        let w: String = what.chars().take(90).collect();
+        eprintln!("[DOM] {} @ {}", w.replace('\n', " "), prof_describe(tree, id));
+    }
+}
